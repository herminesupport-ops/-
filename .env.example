# Discord-style placeholders for compatibility. This base is WhatsApp-only by default.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
WELCOME_CHANNEL_ID=
LEAVE_CHANNEL_ID=
KICK_LOG_CHANNEL_ID=

APP_NAME=Тишина bot
BOT_PREFIX=!
WHATSAPP_PRINT_QR=true
WA_API_BOOTSTRAP_SESSIONS=Тишина_Maxichen
WA_API_RETRY_LIMIT=10
Тишина bot_DRY_RUN=false

PORT=7777
HOST=localhost

# Optional OpenAI-compatible endpoint. The bot stays disabled until an Owner enables it with ,ai on.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_DAILY_LIMIT=10

# Optional event banners. Use URL or local path; path wins only when URL is empty.
WELCOME_BANNER_URL=
LEAVE_BANNER_URL=
KICK_BANNER_URL=
WELCOME_BANNER_PATH=./docs/assets/readme-hero.jpg
LEAVE_BANNER_PATH=./docs/assets/readme-hero.jpg
KICK_BANNER_PATH=./docs/assets/readme-hero.jpg
